#!name = 虎牙直播去广告
#!desc = 移除虎牙直播间活动浮窗、游戏推广与奖励广告素材，并阻断抓包命中的第三方广告 SDK 上报。基于虎牙 iOS 13.4.0 实际抓包制作。
#!author = gj0134
#!tag = 去广告
#!homepage = https://github.com/gj0134/Loon-Plugins
#!date = 2026-08-14

[Rule]
# 腾讯广告 SDK 上报
DOMAIN,sdkreport.e.qq.com,REJECT
DOMAIN,receiver.tdm.qq.com,REJECT

[URL Rewrite]
# 当前抓包中的“夏日魔法师”横屏/竖屏直播间活动浮窗
^https:\/\/zt\.huya\.com\/(?:17250f13|45e2e939)\/mobile\/index\.html(?:\?.*)?$ reject

# 后续同类直播间活动浮窗：请求以 window_activity_id 标识
^https:\/\/zt\.huya\.com\/[^\/?#]+\/mobile\/index\.html\?.*window_activity_id= reject

# “剑与远征”同类游戏推广图标与虎牙游戏中心推广素材
^https:\/\/gameresource\.itop\.qq\.com\/[^?#]+\.(?:jpe?g|png|webp)(?:\?.*)?$ reject-img
^https:\/\/gr\.msstatic\.com\/gamecenter\/image\/[^?#]+\.(?:jpe?g|png|webp)(?:\?.*)?$ reject-img

# 奖励广告任务素材
^https:\/\/livewebbs2\.msstatic\.com\/AdRewards(?:DinnerQuest|PackageTaskGuide)\.png(?:\?.*)?$ reject-img

# 禁用虎牙 HTTPDNS，避免广告请求绕过基于域名的规则
^https?:\/\/cdn\.wup\.huya\.com\/launch\/queryHttpDns(?:\?.*)?$ reject

[MITM]
hostname = zt.huya.com, gameresource.itop.qq.com, gr.msstatic.com, livewebbs2.msstatic.com, cdn.wup.huya.com
