#!name=红果短剧请求记录器
#!desc=不启用 Loon 数据包抓取，仅通过全域 MITM 的 HTTP 脚本层记录请求与响应元数据；测试期间请只打开红果短剧。
#!author=gj0134
#!tag=红果短剧,调试
#!homepage=https://github.com/gj0134/Loon-Plugins
#!date=2026-08-31

[Script]
# 记录所有 HTTP(S) 请求的方法、脱敏 URL 和少量诊断请求头；不读取请求正文。
http-request ^https?:\/\/ script-path=https://raw.githubusercontent.com/gj0134/Loon-Plugins/3b7d785/scripts/hongguo-request-logger.js,requires-body=false,timeout=5,tag=红果全域请求日志

# 记录所有 HTTP(S) 响应的状态码、类型、长度、Range 和重定向；不读取或缓存响应正文。
http-response ^https?:\/\/ script-path=https://raw.githubusercontent.com/gj0134/Loon-Plugins/3b7d785/scripts/hongguo-request-logger.js,requires-body=false,timeout=5,tag=红果全域响应日志

[MitM]
hostname = *
