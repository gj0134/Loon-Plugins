#!name=红果短剧请求记录器
#!desc=不启用 Loon 数据包抓取，仅对红果核心 API 与广告接口执行 MITM 并记录请求、响应元数据，避免全域 MITM 失败。
#!author=gj0134
#!tag=红果短剧,调试
#!homepage=https://github.com/gj0134/Loon-Plugins
#!date=2026-08-31

[Script]
# 记录红果核心 API 和广告接口的方法、脱敏 URL 与少量诊断请求头；不读取请求正文。
http-request ^https?:\/\/(?:api[35]-normal-(?:hl|sinfonlineb)\.fqnovel\.com|ads[35]-normal-hl\.zijieapi\.com)(?:[\/:?#]|$) script-path=https://raw.githubusercontent.com/gj0134/Loon-Plugins/3b7d785/scripts/hongguo-request-logger.js,requires-body=false,timeout=5,tag=红果核心请求日志

# 记录红果核心 API 和广告接口的状态码、类型、长度与重定向；不读取响应正文。
http-response ^https?:\/\/(?:api[35]-normal-(?:hl|sinfonlineb)\.fqnovel\.com|ads[35]-normal-hl\.zijieapi\.com)(?:[\/:?#]|$) script-path=https://raw.githubusercontent.com/gj0134/Loon-Plugins/3b7d785/scripts/hongguo-request-logger.js,requires-body=false,timeout=5,tag=红果核心响应日志

[MitM]
hostname = api3-normal-hl.fqnovel.com, api3-normal-sinfonlineb.fqnovel.com, api5-normal-hl.fqnovel.com, api5-normal-sinfonlineb.fqnovel.com, ads3-normal-hl.zijieapi.com, ads5-normal-hl.zijieapi.com
